rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read and write to guides folder
    match /guides/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow read access to any other files for authenticated users
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }
  }
}
